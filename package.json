{
  "name": "grow-map",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:watch": "turbo watch dev",
    "dev:web": "turbo run dev --filter=@grow-map/web",
    "dev:api": "turbo run dev --filter=@grow-map/api",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "types:generate": "openapi-typescript contracts/openapi.json -o packages/api-client/src/schema.ts"
  },
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.11.7"
  }
}
