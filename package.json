{
  "name": "grow-map",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:watch": "turbo watch dev",
    "dev:web": "turbo run dev --filter=@grow-map/web",
    "dev:api": "turbo run dev --filter=@grow-map/api",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "contract:validate": "openapi-generator validate -i contracts/openapi.json",
    "types:generate:react": "openapi-typescript contracts/openapi.json -o packages/api-client/src/schema.ts",
    "types:generate:rust": "openapi-generator generate -i contracts/openapi.json -g rust -o crates/api-contract --additional-properties=packageName=grow_map_contract,packageVersion=0.1.0,hideGenerationTimestamp=true",
    "types:generate": "pnpm contract:validate && pnpm types:generate:rust && pnpm types:generate:react"
  },
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.11.7"
  }
}
