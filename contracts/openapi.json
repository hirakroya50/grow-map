    "/graphql/ws": {
      "get": {
        "operationId": "upgradeGraphQLWebSocket",
        "summary": "Upgrade to graphql-transport-ws",
        "security": [],
        "description": "Authentication is in connection_init payload authorization, within five seconds. Do not use token URL parameters. OpenAPI describes only the HTTP upgrade. Subscription fields and payloads are in schema.graphql; protocol semantics in docs/architecture.md. Close 4401/4403 for auth failure, 4408 for initialization timeout.",
        "parameters": [
          {
            "name": "Upgrade",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "websocket"
            }
          },
          {
            "name": "Sec-WebSocket-Protocol",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "graphql-transport-ws"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols; standard RFC6455 handshake required",
            "headers": {
              "X-Request-Id": {
                "description": "Server request UUID for support and logs.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
