            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphQLRequest"
              },
              "examples": {
                "myRoadmaps": {
                  "value": {
                    "operationName": "MyRoadmaps",
                    "query": "query MyRoadmaps { myRoadmaps(first: 20) { items { id title revision } pageInfo { endCursor hasNextPage } } }"
                  }
                },
                "createRoadmap": {
                  "value": {
                    "operationName": "CreateRoadmap",
                    "query": "mutation CreateRoadmap($input: CreateRoadmapInput!) { createRoadmap(input: $input) { operationId sequence roadmap { id title revision } } }",
                    "variables": {
                      "input": {
                        "operationId": "63a97329-a8c3-4923-adb9-ceb1865f13c1",
                        "title": "Rust development",
                        "visibility": "PRIVATE"
